{
  "name": "subagent-model-pin",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DSH profile plugin: default subagents to a low-cost route, with per-role route and sandbox tiers; explicit provider/model upgrades still win. Ships a Plugins-page config card for the four hot fields.",
  "license": "MIT",
  "main": "./plugin.mjs",
  "exports": {
    ".": "./plugin.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "plugin.mjs",
    "client.js",
    "cordis.patch.yml",
    "lib/",
    "locale/",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cosmokit": "~1.8.6"
  }
}
